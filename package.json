{
  "name": "rightflow",
  "displayName": "RightFlow - Universal RTL and Arabic Engine for AI IDEs",
  "description": "Universal Arabic, Hebrew and Persian RTL and BiDi engine for AI Coding IDEs and Agents: Antigravity IDE, Cursor, VS Code Copilot, Windsurf, Chat, Prompt Input, Plan files, Work/Tasks, Markdown, and Monaco Editor.",
  "version": "1.0.28",
  "publisher": "isl2m",
  "author": "Islam Fathy",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/isl2m/rightflow"
  },
  "homepage": "https://github.com/isl2m/rightflow#readme",
  "bugs": {
    "url": "https://github.com/isl2m/rightflow/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "rtl",
    "arabic",
    "hebrew",
    "persian",
    "bidi",
    "antigravity",
    "cursor",
    "copilot",
    "windsurf",
    "cascade",
    "chat",
    "monaco"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rightflow.activate",
        "title": "Activate RTL Suite (All Panels)",
        "category": "RightFlow"
      },
      {
        "command": "rightflow.deactivate",
        "title": "Deactivate RTL Suite",
        "category": "RightFlow"
      },
      {
        "command": "rightflow.toggleEditorRtl",
        "title": "Toggle Editor RTL Direction",
        "category": "RightFlow"
      },
      {
        "command": "rightflow.toggleChatRtl",
        "title": "Toggle Chat RTL Mode",
        "category": "RightFlow"
      },
      {
        "command": "rightflow.toggleMenu",
        "title": "Universal RTL Control Center",
        "category": "RightFlow"
      },
      {
        "command": "rightflow.status",
        "title": "Check RTL Status & Diagnostics",
        "category": "RightFlow"
      },
      {
        "command": "rightflow.restart",
        "title": "Re-inject / Update Assets",
        "category": "RightFlow"
      },
      {
        "command": "rightflow.setupFonts",
        "title": "Setup Arabic Typography in Editor",
        "category": "RightFlow"
      }
    ],
    "keybindings": [
      {
        "command": "rightflow.toggleEditorRtl",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "configuration": {
      "title": "RightFlow RTL Engine",
      "properties": {
        "rightflow.mode": {
          "type": "string",
          "enum": [
            "active",
            "inactive"
          ],
          "default": "active",
          "description": "RightFlow RTL Suite operational state."
        },
        "rightflow.chatFontFamily": {
          "type": "string",
          "default": "'Segoe UI', 'Cairo', 'Tajawal', 'Almarai', Tahoma, -apple-system, sans-serif",
          "description": "Preferred font family for Arabic/RTL text in AI Chat and Agents."
        },
        "rightflow.editorFontFamily": {
          "type": "string",
          "default": "'Segoe UI', 'Cairo', 'Cascadia Code', Consolas, monospace",
          "description": "Preferred font family when RTL is active in the code editor."
        },
        "rightflow.lineHeightRatio": {
          "type": "number",
          "default": 1.75,
          "description": "Line height ratio for Arabic text rendering."
        },
        "rightflow.enhanceFonts": {
          "type": "boolean",
          "default": true,
          "description": "Automatically enhance Arabic typography."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "test": "node --test",
    "package": "vsce package --no-dependencies",
    "patch": "node scripts/patch.mjs",
    "unpatch": "node scripts/unpatch.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
